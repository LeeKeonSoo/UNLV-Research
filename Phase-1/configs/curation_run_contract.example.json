{
  "schema_version": "curation-run-contract-v1",
  "status": "frozen_before_stage_a_b_c_materialization",
  "curation_mode": "normal",
  "input": {
    "sources": [
      {
        "path": "C:/path/to/source-a.jsonl",
        "text_fields": ["text", "content", "document", "body"],
        "defaults": {
          "source_name": "declared-upstream-source-a",
          "source_uri": "https://example.invalid/source-a-manifest",
          "collected_at": "2026-07-22T00:00:00Z",
          "pii_context": "general",
          "normalization_context": "preserve",
          "rights": {
            "status": "allowed",
            "license": "declared-license"
          },
          "language": {"code": "und", "confidence": null},
          "artifact_context": {"generation": "unknown"},
          "artifact_context_fields": {
            "generation": "source_declared_generation",
            "dependency_copy": "source_declared_dependency_copy"
          },
          "metadata_capabilities": {
            "artifact_context.generation": {"availability": "provided_by_source_field", "source_field": "source_declared_generation"},
            "artifact_context.dependency_copy": {"availability": "provided_by_source_field", "source_field": "source_declared_dependency_copy"}
          }
        }
      }
    ]
  },
  "output_dir": "C:/path/to/curation-output",
  "stage_b": {
    "name": "chunk_level_hard_gate",
