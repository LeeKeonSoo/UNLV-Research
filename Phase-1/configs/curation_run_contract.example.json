    "forbidden_inputs": ["Utility", "NLL", "benchmark outcomes", "source pool role"]
  },
  "stage_c": {
    "name": "reason_coded_duplicate_artifact_and_scaffold_compaction_and_materialization",
    "minimum_residual_chars": 120,
    "no_binding_budget_action": "selection_without_binding_budget",
    "forbidden_inputs": ["Utility", "NLL", "benchmark outcomes", "source pool role"]
  },
  "policy_note": "Stage-A, Stage-B policy switches, and Stage-C selection rules are supplied only by the immutable curation_mode profile.",
  "external_evaluation": {
    "forbidden_feedback": "External metrics may not mutate this frozen Stage-C output."
  },
  "composition_audit": {
    "role": "audit_only",
    "note": "Content-domain and language/script distributions are reported but cannot remove or select records."
  },
  "claim_boundary": "Auditable curation materialization only; no intrinsic quality, semantic necessity, benchmark-cleanliness, or downstream-performance claim."
}
