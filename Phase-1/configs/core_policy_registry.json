{
  "schema_version": "core-policy-registry-v2",
  "purpose": "Authoritative lifecycle registry for every Core policy. A policy card supplies its operational declaration; this registry binds activation, metadata, fixture, case-matrix, coverage, and promotion evidence.",
  "authoritative_policy_definition": "configs/policy_cards.json",
  "activation_states": [
    "candidate",
    "runtime_executable",
    "development_validated",
    "confirmatory_validated",
    "production_validated",
    "retired"
  ],
  "lifecycle_dimensions": {
    "execution_state": "activation_state records whether code can execute the declared policy",
    "profile_enablement": "runtime_profile_authorization.enabled_policy_ids records whether a profile invokes it",
    "evidence_state": "the linked policy card empirical_status records validation evidence independently from execution"
  },
  "default_promotion_requirements": [
    "structural_fixture_passed",
    "reason_code_audit_complete",
    "development_ablation_pre_registered",
    "confirmatory_evaluation_without_runtime_feedback"
  ],
  "runtime_profile_authorization": {
    "normal_structural_v1": {
      "stage_a_policy": "text_only_v2",
      "authorized_policy_ids": [
        "stage_a_normalized_text_integrity",
        "stage_a_bom_normalization",
        "stage_b_invalid_chunk",
        "stage_b_exact_duplicate",
        "stage_c_symmetric_near_duplicate",
        "stage_c_explicit_generated_artifact",
        "stage_c_license_comment_only",
        "stage_c_structural_scaffold",
        "stage_c_empty_html_shell",
        "stage_c_web_chrome_only_chunk"
      ],
      "enabled_policy_ids": [
        "stage_a_normalized_text_integrity",
        "stage_a_bom_normalization",
        "stage_b_invalid_chunk",
        "stage_b_exact_duplicate",
        "stage_c_symmetric_near_duplicate",
        "stage_c_explicit_generated_artifact",
        "stage_c_license_comment_only",
        "stage_c_structural_scaffold",
        "stage_c_empty_html_shell",
        "stage_c_web_chrome_only_chunk",
        "stage_c_coverage_guard"
      ],
      "excluded_policy_ids": [
        "stage_a_provenance_contract",
        "stage_a_risk_quarantine",
        "stage_a_b_validity_recovery_candidate",
        "stage_c_route_conditioned_quality_candidate",
        "stage_c_declared_dependency_copy_candidate",
        "stage_c_explicit_error_navigation_only_candidate",
        "stage_c_url_directory_only_candidate"
      ],
      "authorized_but_disabled_policy_ids": []
    }
  },
  "core_decision_contracts": {
    "quality": {
      "runtime_owner": "quality_retention.py",
      "execution_order": "after_redundancy_before_coverage_audit",
      "decisions": [
        "keep",
        "reject",
        "abstain_retain"
      ],
      "abstain_action": "retain",
      "reject_authority": "named_active_policy_with_explicit_non_payload_evidence",
      "decision_contract": "quality_retention_deletion_authority_v2",
      "reject_required_trace": [
        "policy_scope_route",
        "routing_precondition",
        "policy_id",
        "policy_version",
        "reason_code",
        "trigger",
        "observed_evidence",
        "representative_fixture_id",
        "false_positive_fixture_id",
        "original_text_sha256",
        "policy_artifact_sha256",
        "token_delta_proxy"
      ],
      "missing_trace_action": "reject_decision_construction_fails",
      "keep_authority": "reserved_for_separately_validated_positive_retention_policy",
      "intrinsic_quality_score_used": false,
      "weighted_score_used": false,
      "benchmark_outcomes_read": false
    },
    "candidate_route_conditioned_quality_v2": {
      "runtime_owner": "route_conditioned_quality.py",
      "runtime_activation": false,
      "evidence_gate": "configs/quality_route_evidence_gate_v2.json",
      "candidate_evidence_adapter": "route_quality_evidence_candidates.py",
      "candidate_evidence_registry": "configs/route_quality_evidence_candidates_v1.json",
      "routing_precondition": {
        "name": "route_confidence",
        "quality_evidence": false,
        "may_authorize_removal": false
      },
      "required_heads": [
        "substantive_payload",
        "route_specific_evidence"
      ],
      "coherence_owned_by_validity": true,
      "route_label_is_quality_evidence": false,
      "registered_route_evidence_status": {
        "general_prose": "missing_and_indeterminate",
        "code_artifact": "missing_and_indeterminate",
        "mathematical_content": "indeterminate_and_indeterminate",
        "technical_documentation": "missing_and_missing",
        "conversation": "missing_and_missing",
        "instruction": "missing_and_missing",
        "table_structured_data": "missing_and_missing"
      },
      "weighted_score_used": false,
      "benchmark_outcomes_read": false
    }
  },
