  "policies": [
    {
      "policy_id": "q1_correctness_evidence",
      "name": "Correctness Evidence",
      "question": "Does locally observable or attached verifier evidence support that the payload is correct under its declared context?",
      "fail_boundary": "Fail only on a reproducible contradiction, impossible derivation, failed declared verifier, or locally checkable incorrect result.",
      "abstain_boundary": "Abstain when correctness requires unavailable external knowledge or undeclared execution assumptions.",
      "reason_codes": {
        "pass": ["observable_correctness_evidence"],
        "fail": ["reproducible_contradiction", "impossible_derivation", "declared_verifier_failed", "locally_checkable_incorrect_result"],
        "abstain": ["external_knowledge_required", "undeclared_execution_assumption", "insufficient_correctness_evidence"]
      }
    },
    {
      "policy_id": "q2_semantic_coherence",
      "name": "Semantic Coherence",
      "question": "Do the payload's parts form a consistent and recoverable semantic unit?",
      "fail_boundary": "Fail only when incompatible fragments, broken dependencies, or internal contradictions prevent a coherent interpretation.",
      "abstain_boundary": "Abstain when missing context could plausibly repair the apparent discontinuity.",
      "reason_codes": {
        "pass": ["recoverable_semantic_unit"],
        "fail": ["incompatible_fragments", "broken_required_dependency", "internal_semantic_contradiction"],
        "abstain": ["missing_context_may_repair_coherence", "specialized_semantics_unavailable"]
      }
    },
    {
      "policy_id": "q3_substantive_payload",
      "name": "Substantive Payload",
      "question": "Does the unit contain substantive content beyond navigation, metadata, boilerplate, or an uninstantiated template?",
      "fail_boundary": "Fail only when no substantive residual payload remains after observable boilerplate is excluded.",
      "abstain_boundary": "Abstain when a short unit may carry domain-specific meaning that the panel cannot verify.",
      "reason_codes": {
        "pass": ["substantive_payload_present"],
        "fail": ["navigation_only", "metadata_only", "boilerplate_only", "uninstantiated_template_only", "no_substantive_residual"],
        "abstain": ["short_domain_payload_uncertain", "specialized_payload_uncertain"]
      }
    },
    {
      "policy_id": "q4_learnable_relations",
      "name": "Learnable Relations",
      "question": "Does the unit expose at least one recoverable relation among entities, operations, claims, conditions, or outcomes?",
      "fail_boundary": "Fail only when the payload is an unconnected token, label, or fragment set with no recoverable relation.",
      "abstain_boundary": "Abstain when specialized notation may encode a relation unavailable to the panel.",
      "reason_codes": {
        "pass": ["recoverable_relation_present"],
        "fail": ["unconnected_token_set", "label_only_without_relation", "fragment_set_without_relation"],
        "abstain": ["specialized_notation_relation_uncertain", "missing_context_relation_uncertain"]
      }
    }
  ],
  "response_contract": {
    "decision_enum": ["pass", "fail", "abstain"],
    "reason_codes_required": true,
    "reason_code_pattern": "^[a-z][a-z0-9_]{0,63}$",
    "maximum_schema_retries": 1,
    "invalid_response_action": "abstain"
  },
