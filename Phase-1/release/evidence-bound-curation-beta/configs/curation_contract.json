{
  "schema_version": "curation-contract-v2",
  "status": "beta_release_contract",
  "purpose": "Define the dataset-in to curated-dataset-out framework boundary without external evaluation feedback.",
  "framework_root": "configs/curation_framework_v1.json",
  "canonical_cores": ["validity", "redundancy", "quality", "coverage"],
  "curation_engine": {
    "included_stages": ["Stage A", "Stage B", "Stage C"],
    "curated_output": "full_reason_coded_curated_pool",
    "completion_rule": "A run completes only after Stage-C Coverage evaluates Stage-B non-selection proposals and final materialization passes a complete recheck.",
    "public_modes": ["framework"],
    "beta_release_enabled_modes": ["framework"],
    "production_release_enabled_modes": [],
    "fixed_retention_fraction_allowed": false,
    "maximum_token_budget_allowed": false
  },
  "runtime_forbidden_inputs": [
    "intrinsic_quality_score",
    "weighted_quality_score",
    "human_quality_label",
    "unversioned_human_quality_judgment",
    "Utility",
    "NLL",
    "benchmark_outcomes",
    "target_retention_fraction",
    "maximum_token_budget",
    "source_reputation",
    "source_pool_role",
    "source_tier",
    "domain_quota",
    "target_domain_distribution",
    "composition"
  ],
  "stage_a": {
    "role": "validity_hard_gate",
    "core_ids": ["validity"],
    "allowed_effects": ["normalize_without_payload_change", "quarantine_closed_input_failure"],
    "required_trace": ["unit_id", "reason_code", "observable_evidence", "action"],
    "uncertainty_action": "retain_or_quarantine_without_quality_claim"
  },
  "stage_b": {
    "role": "redundancy_removal_and_positive_quality_membership_filtering",
    "core_ids": ["redundancy", "quality"],
    "implemented_decisions": [
      "stable_family_nonrepresentative_proposal",
      "reason_coded_qualified_quality_failure_proposal",
      "conjunctive_quality_positive_support_retention",
      "completed_fallback_without_conjunctive_support_non_selection"
    ],
    "required_trace": [
      "chunk_uid",
      "core_id",
      "policy_id",
      "policy_version",
      "reason_code",
      "observed_evidence",
      "passed_and_failed_policy_ids_when_quality",
      "representative_chunk_uid_when_redundancy",
      "evidence_artifact_sha256",
      "token_delta_proxy"
    ],
    "proposal_is_final_membership": false,
    "similarity_alone_may_delete": false,
    "teacher_output_alone_may_select_or_delete": true,
    "uncertainty_action": "luna_fallback_then_not_select_if_complete_without_conjunctive_support"
  },
  "stage_c": {
    "role": "coverage_veto_and_final_materialization",
    "core_ids": ["coverage"],
    "may_create_new_removal": false,
    "may_rank_or_impose_quota": false,
    "allowed_effects": ["accept_stage_b_non_selection", "veto_unexplained_support_loss"],
    "semantic_candidate_contract": "configs/semantic_coverage_v3.json",
    "required_retain_is_explicit": true,
    "silent_restore_allowed": false,
    "complete_recheck_required_after_veto": true,
    "single_profile_invariants": true,
    "uncertainty_semantics": "Semantic uncertainty gives no removal authority; Stage C prevents unexplained support extinction while independently supported Stage-B decisions remain eligible."
  },
  "core_authority": {
    "validity": {
      "stage": "Stage A",
      "authority": "quarantine or remove only closed observable input-contract failures"
    },
    "redundancy": {
      "stage": "Stage B",
      "authority": "propose removal of reproducibly linked nonrepresentative family members"
    },
    "quality": {
      "stage": "Stage B",
      "authority": "retain local or Luna conjunctive Q2+Q3+Q4 positive support; remove qualified local or confirmed Luna failures and completed Luna cases without conjunctive support; Q1 acts as a qualified-failure veto and missing provider evidence stops materialization"
    },
    "coverage": {
      "stage": "Stage C",
      "authority": "veto unexplained representative or semantic-support extinction without deleting, ranking, or quota authority"
    }
  },
  "composition_artifacts": {
    "authority": "audit_only",
    "may_remove_or_select": false,
    "target_distribution_enforced": false,
    "comparable_baseline_stage": "Stage B pass",
    "comparison_unit": "chunk",
    "raw_record_to_chunk_delta_authority": "descriptive_only_cross_unit",
    "reported_axes": ["content_route", "language_script", "format_morphology"]
  },
  "core_behavior_audit": {
    "schema_version": "core-behavior-audit-v3",
    "executor": "validation/core_behavior_audit_v3.py",
    "fixture_registry": "validation/fixtures/core_behavior_audit_v3_cases.json",
    "case_matrix": "validation/fixtures/core_case_matrix.json",
    "required_dimensions": {
      "validity": ["reason_coded_action", "non_trigger_retention"],
      "redundancy": ["representative_linkage", "representative_survival", "non_trigger_retention"],
      "quality": ["typed_quality_decision_authority", "observable_evidence_trace", "membership_boundary"],
      "coverage": ["materialization_invariant_authority", "representative_linkage_detection", "zero_survivor_detection"]
    },
    "claim_boundary": "Passing constructed fixtures establishes declared behavior only, not corpus-wide validity or downstream effectiveness."
  },
  "external_evaluation": {
    "role": "external_offline_validation",
    "runtime_stage": false,
    "selector_visible": false,
    "may_mutate_or_reselect_frozen_output": false,
    "natural_token_training": true,
    "equal_token_resampling_allowed": false,
    "seeds": [101, 202, 303]
  }
}
