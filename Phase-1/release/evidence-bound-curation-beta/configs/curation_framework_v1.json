{
  "schema_version": "curation-framework-v1",
  "activation": "beta_release_v1",
  "research_contract": {
    "path": "docs/framework_research_contract_v1.md",
    "sha256": "edff647749877b72ebb225b6fe9afa5936ec73e49150d1629273b6eaf53febf4"
  },
  "hierarchy": ["core", "metric", "policy", "method"],
  "cores": [
    {
      "id": "validity",
      "stage_ids": ["stage_a"],
      "question": "Can the unit be interpreted and trained on under the declared input contract without inventing or destroying payload?",
      "authority": "quarantine_or_remove_by_closed_observable_failure",
      "may_delete": true,
      "may_veto_materialization": false
    },
    {
      "id": "redundancy",
      "stage_ids": ["stage_b"],
      "question": "Is the same training information already represented by another reproducibly linked family member?",
      "authority": "propose_nonrepresentative_family_member_removal",
      "may_delete": true,
      "may_veto_materialization": false
    },
    {
      "id": "quality",
      "stage_ids": ["stage_b"],
      "question": "Does this valid nonredundant unit have positive Q1-Q4 support for retention, or completed evidence that justifies exclusion from the curated LM-training dataset?",
      "authority": "retain_positive_support_and_exclude_qualified_or_completed_unsupported_evidence",
      "may_delete": true,
      "may_veto_materialization": false
    },
    {
      "id": "coverage",
      "stage_ids": ["stage_c"],
      "question": "Did combined removals erase valid support without an authorized explanation?",
      "authority": "verify_representative_survival_and_veto_unexplained_support_loss",
      "may_delete": false,
      "may_veto_materialization": true
    }
  ],
  "stages": [
    {
      "id": "stage_a",
      "position": 1,
      "scope": "record_and_chunk_hard_gate",
      "core_ids": ["validity"],
      "allowed_input_categories": ["raw_text", "declared_input_contract", "deterministic_normalized_text", "stable_identifiers"],
      "forbidden_input_categories": ["utility", "nll", "benchmark_outcomes", "target_retention_fraction", "maximum_token_budget", "source_reputation", "source_tier", "domain_quota", "confirmatory_outcomes"]
    },
    {
      "id": "stage_b",
      "position": 2,
      "scope": "family_and_payload_decisions",
      "core_ids": ["redundancy", "quality"],
      "allowed_input_categories": ["stage_a_survivors", "deterministic_normalized_text", "stable_identifiers", "runtime_local_structural_evidence", "promoted_frozen_model_evidence", "frozen_external_quality_observation", "prior_stage_reason_codes"],
      "forbidden_input_categories": ["utility", "nll", "benchmark_outcomes", "target_retention_fraction", "maximum_token_budget", "source_reputation", "source_tier", "domain_quota", "confirmatory_outcomes"]
    },
    {
      "id": "stage_c",
      "position": 3,
      "scope": "coverage_and_final_materialization",
      "core_ids": ["coverage"],
      "allowed_input_categories": ["stage_b_survivors", "typed_non_selection_proposals", "representative_links", "promoted_coverage_taxonomy", "prior_stage_reason_codes"],
      "forbidden_input_categories": ["utility", "nll", "benchmark_outcomes", "target_retention_fraction", "maximum_token_budget", "source_reputation", "source_tier", "domain_quota", "confirmatory_outcomes", "new_quality_score", "new_ranking_objective", "quota_based_restoration"]
    }
  ],
  "runtime_forbidden_inputs": ["utility", "nll", "benchmark_outcomes", "target_retention_fraction", "maximum_token_budget", "source_reputation", "source_tier", "domain_quota", "confirmatory_outcomes", "unversioned_human_quality_judgment"],
  "profile_contract": {
    "public_profiles": ["framework"],
    "retained_set_invariant": "single_profile",
    "fixed_retention_fraction_allowed": false,
    "maximum_token_budget_allowed": false,
    "shared_policy_families_required": false,
    "independent_operating_point_calibration_required": false,
    "arbitrary_threshold_override_allowed": false
  },
  "threshold_provenance": {
    "required_fields": ["value", "unit", "comparison_direction", "derivation_procedure", "development_corpus_sha256", "sample_count", "supported_routes", "provider_identity_sha256", "tokenizer_identity_sha256", "uncertainty_procedure", "fixture_artifact_sha256", "ablation_artifact_sha256", "external_evidence_sha256", "lifecycle", "invalidation_conditions"],
    "missing_field_action": "retain"
  },
  "registry_references": {
    "quality_ranker": "configs/quality_ranker_v1.json",
    "runtime_contract": "configs/curation_contract.json",
    "runtime_policy_registry": "configs/runtime_policy_registry_v1.json",
    "runtime_policy_profiles": "configs/runtime_policy_profiles_v1.json",
    "provider_registry": "configs/model_provider_registry_v1.json",
    "deployment_surface": "configs/deployment_surface_v1.json"
  },
  "external_evaluation": {
    "runtime_stage": false,
    "selector_visible": false,
    "data_arms": ["raw_audited_natural", "framework_curated_natural"],
    "untrained_base_reference": true,
    "natural_token_training": true,
    "seeds": [101, 202, 303],
    "equal_token_resampling_allowed": false,
    "common_sensitivity_baseline_required": true,
    "development_confirmatory_disjoint": true
  }
}
