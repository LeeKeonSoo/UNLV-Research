{
  "schema_version": "curation-run-contract-v1",
  "status": "frozen_before_stage_a_b_c_materialization",
  "curation_mode": "framework",
  "execution_scope": "confirmatory",
  "input": {
    "sources": [
      {
        "path": "C:/path/to/input.jsonl",
        "text_fields": ["text", "content", "document", "body"],
        "defaults": {
          "source_name": "declared-input",
          "normalization_context": "preserve",
          "rights": {
            "status": "unknown",
            "license": "unknown"
          },
          "language": {
            "code": "und",
            "confidence": null
          },
          "artifact_context": {
            "generation": "unknown",
            "dependency_copy": false
          }
        }
      }
    ]
  },
  "output_dir": "C:/path/to/curation-output",
  "stage_b": {
    "max_chunk_chars": 6000
  },
  "stage_c": {
    "minimum_residual_chars": 120,
    "no_binding_budget_action": "selection_without_binding_budget"
  },
  "quality_runtime": {
    "method": "distilled_quality_ranker_v1",
    "ranker_manifest_path": "C:/path/to/frozen-quality-ranker/manifest.json",
    "redundancy_checkpoint_path": "C:/path/to/curation-output/checkpoints/stage_b_redundancy_v2.json"
  },
  "runtime_artifacts": {
    "mode": "auto",
    "output_root": "C:/path/to/curation-output/runtime-artifacts",
    "cache_dir": "C:/path/to/model-cache",
    "provider_registry": "configs/model_provider_registry_v1.json",
    "providers": {
      "primary": {
        "provider_id": "qwen3-embedding-0.6b-semantic-candidate",
        "pooling": "last_token",
        "max_length": 8192,
        "batch_size": 8,
        "device": "cuda:0",
        "append_eos": false
      },
      "audit": {
        "provider_id": "bge-m3-semantic-audit-candidate",
        "pooling": "cls",
        "max_length": 8192,
        "batch_size": 8,
        "device": "cuda:0",
        "append_eos": false
      }
    },
    "neighbor_count": 8,
    "block_size": 512,
    "graph_device": "cuda:0"
  },
  "composition_audit": {
    "role": "audit_only"
  },
  "claim_boundary": "Auditable curation materialization; external evaluation is not part of runtime membership decisions."
}
