{
  "schema_version": "quality-ranker-contract-v1",
  "lifecycle": "frozen_artifact_runtime_beta",
  "core": "quality",
  "stage": "stage_b",
  "definition": "A frozen multi-policy classifier emits independent Q1-Q4 pass/fail/abstain evidence. A qualified local FAIL proposes removal; the conjunction of Q2 semantic coherence, Q3 substantive payload, and Q4 learnable relations PASS provides positive retention support. Q1 correctness acts as a qualified-failure veto because correctness may be unverifiable from an isolated chunk. All other local outcomes are resolved by the frozen GPT-5.6 Luna Batch fallback. A completed fallback without conjunctive positive support is not selected, while missing or invalid provider evidence stops materialization without changing membership. No scalar intrinsic Quality score is defined or weighted.",
  "encoder": {
    "provider_id": "qwen3-embedding-0.6b-semantic-candidate",
    "provider_identity_sha256": "529af20b304f15803a7b93282543c1a2ed36fc03c0d4e8e024a57a1a88c4fd02",
    "pooling": "last_token",
    "long_document_strategy": "exhaustive_nonoverlapping_window_mean",
    "frozen_identity_required": true
  },
  "policy_heads": [
    "q1_correctness_evidence",
    "q2_semantic_coherence",
    "q3_substantive_payload",
    "q4_learnable_relations"
  ],
  "output_enum": ["pass", "fail", "abstain"],
  "framework_contract": {
    "shared_model_required": true,
    "runtime_failure_threshold_field": "failure_threshold",
    "legacy_artifact_threshold_adapter": "hard_fail_threshold",
    "qualified_fail_action": "not_select",
    "positive_support_rule": "q2_and_q3_and_q4_pass",
    "pass_action": "retain_only_when_positive_support_rule_holds",
    "absence_of_pass_action": "luna_fallback_then_not_select_without_positive_support",
    "threshold_derivation": "teacher_labeled_training_and_calibration_then_separate_uid_and_text_hash_disjoint_protected_test",
    "protected_observation_minimum_negative_count_per_head": 600,
    "protected_observation_teacher_requirement": "all_three_frozen_teachers",
    "arbitrary_runtime_threshold_override_allowed": false
  },
  "uncertainty_contract": {
    "low_confidence_action": "luna_fallback",
    "out_of_distribution_action": "luna_fallback",
    "missing_provider_observation_action": "emit_requests_and_stop_without_membership_change",
    "completed_fallback_without_positive_support_action": "not_select",
    "oversized_review_queue_action": "batch_materialize_fallback_evidence_before_curation",
    "partial_input_order_review_allowed": false
  },
