{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unlv-research.local/schemas/curation-framework-v1.json",
  "title": "Curation Framework v1 Root Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activation", "research_contract", "hierarchy", "cores", "stages", "runtime_forbidden_inputs", "profile_contract", "threshold_provenance", "registry_references", "external_evaluation"],
  "properties": {
    "schema_version": {"const": "curation-framework-v1"},
    "activation": {"const": "beta_release_v1"},
    "research_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "hierarchy": {"const": ["core", "metric", "policy", "method"]},
    "cores": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/core"}},
    "stages": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/stage"}},
    "runtime_forbidden_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "profile_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_profiles", "retained_set_invariant", "fixed_retention_fraction_allowed", "maximum_token_budget_allowed", "shared_policy_families_required", "independent_operating_point_calibration_required", "arbitrary_threshold_override_allowed"],
      "properties": {
        "public_profiles": {"const": ["normal", "hard"]},
        "retained_set_invariant": {"const": "hard_subset_or_equal_normal"},
        "fixed_retention_fraction_allowed": {"const": false},
        "maximum_token_budget_allowed": {"const": false},
        "shared_policy_families_required": {"const": true},
        "independent_operating_point_calibration_required": {"const": true},
        "arbitrary_threshold_override_allowed": {"const": false}
      }
    },
    "threshold_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "missing_field_action"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 15, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_field_action": {"const": "not_select"}
      }
    },
    "registry_references": {"$ref": "#/$defs/pathMap"},
    "external_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_stage", "selector_visible", "data_arms", "untrained_base_reference", "natural_token_training", "seeds", "equal_token_resampling_allowed", "common_sensitivity_baseline_required", "development_confirmatory_disjoint"],
      "properties": {
        "runtime_stage": {"const": false},
        "selector_visible": {"const": false},
        "data_arms": {"const": ["raw_audited_natural", "normal_natural", "hard_natural"]},
        "untrained_base_reference": {"const": true},
        "natural_token_training": {"const": true},
        "seeds": {"const": [101, 202, 303]},
        "equal_token_resampling_allowed": {"const": false},
        "common_sensitivity_baseline_required": {"const": true},
        "development_confirmatory_disjoint": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage_ids", "question", "authority", "may_delete", "may_veto_materialization"],
      "properties": {
        "id": {"enum": ["validity", "redundancy", "quality", "coverage"]},
        "stage_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stage_a", "stage_b", "stage_c"]}},
        "question": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "may_delete": {"type": "boolean"},
        "may_veto_materialization": {"type": "boolean"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "scope", "core_ids", "allowed_input_categories", "forbidden_input_categories"],
      "properties": {
        "id": {"enum": ["stage_a", "stage_b", "stage_c"]},
        "position": {"type": "integer", "minimum": 1, "maximum": 3},
        "scope": {"type": "string", "minLength": 1},
        "core_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["validity", "redundancy", "quality", "coverage"]}},
        "allowed_input_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_input_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "pathMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
