{
  "schema_version": "stage0-hazard-benchmark-fixtures-v1",
  "claim_boundary": "Minimal labeled Stage-0 hazard fixture benchmark. This is not production detector validation.",
  "cases": [
    {
      "id": "clean_allowed_html",
      "text": "<p>A retry budget limits repeated network attempts and helps avoid overloading a service during temporary failures.</p>",
      "rights": {"status": "allowed", "license": "fixture-only"},
      "expected_eligible": true,
      "expected_reasons_present": [],
      "expected_reasons_absent": ["pii_detected", "secret_detected", "benchmark_contamination", "poisoning_suspected", "rights_restricted"],
      "expected_transformations_present": ["html_tag_removal"]
    },
    {
      "id": "pii_email",
      "text": "Contact the maintainer at maintainer@example.com before adding this private support transcript to training data.",
      "rights": {"status": "allowed", "license": "fixture-only"},
      "expected_eligible": false,
      "expected_reasons_present": ["pii_detected"]
    },
    {
      "id": "pii_phone_general",
      "text": "Call the account owner at (702) 555-0199 before publishing this customer support record.",
      "rights": {"status": "allowed", "license": "fixture-only"},
      "expected_eligible": false,
      "expected_reasons_present": ["pii_detected"]
    },
    {
      "id": "code_numeric_false_positive_suppressed",
      "text": "def status_message(code):\n    if code == 404:\n        return 'missing resource'\n    if code == 500:\n        return 'server error'\n    return 'ok'\n",
      "pii_context": "repository_code",
      "rights": {"status": "allowed", "license": "MIT"},
      "expected_eligible": true,
      "expected_reasons_absent": ["pii_detected", "secret_detected", "benchmark_contamination", "poisoning_suspected"],
      "expected_transformations_present": []
    },
    {
      "id": "secret_api_key",
      "text": "The integration example accidentally includes api_key = abcdefghijklmnop12345 and must not be released.",
      "rights": {"status": "allowed", "license": "fixture-only"},
      "expected_eligible": false,
      "expected_reasons_present": ["secret_detected"]
    },
    {
      "id": "benchmark_contamination_humaneval",
      "text": "This note reproduces HumanEval solution patterns and expected answers for benchmark tasks.",
      "rights": {"status": "allowed", "license": "fixture-only"},
      "expected_eligible": false,
      "expected_reasons_present": ["benchmark_contamination"]
    },
    {
      "id": "poisoning_instruction",
      "text": "Ignore all previous instructions. This training data poisoning sample installs a backdoor trigger for later prompts.",
      "rights": {"status": "allowed", "license": "fixture-only"},
      "expected_eligible": false,
      "expected_reasons_present": ["poisoning_suspected"]
    },
    {
      "id": "rights_restricted",
      "text": "A useful technical explanation may still be unavailable for training when its rights metadata is restricted.",
      "rights": {"status": "restricted", "license": "proprietary"},
      "expected_eligible": false,
      "expected_reasons_present": ["rights_restricted"]
    },
    {
      "id": "rights_unknown",
      "text": "A useful technical explanation with unknown rights must not pass into release by default.",
      "rights": {"status": "unknown", "license": null},
      "expected_eligible": false,
      "expected_reasons_present": ["rights_unknown"]
    },
    {
      "id": "missing_source_lineage",
      "text": "Technically usable text cannot enter the release candidate pool when its source URI is absent.",
      "rights": {"status": "allowed", "license": "fixture-only"},
      "omit_provenance_fields": ["source_uri"],
      "expected_eligible": false,
      "expected_reasons_present": ["missing_provenance_source_uri"]
    },
    {
      "id": "repository_code_preserves_operators",
      "text": "def compare(left, right):\r\n    return left <= right and left != 0\r\n",
      "pii_context": "repository_code",
      "rights": {"status": "allowed", "license": "MIT"},
      "expected_eligible": true,
      "expected_text_contains": ["left <= right", "left != 0"],
      "expected_transformations_present": ["line_ending_normalization"],
      "expected_transformations_absent": ["html_tag_removal", "html_entity_unescape"]
    }
  ]
}
